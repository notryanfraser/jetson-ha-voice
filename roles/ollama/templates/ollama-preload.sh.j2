#!/bin/sh
# {{ ansible_managed }}
# Load the Home Assistant voice model into Ollama at boot, fully on the GPU.
# Waits for whisper.cpp and Phonon (TTS) first, so the model is placed after their memory is
# taken; if Ollama still splits it onto the CPU, unload, drop caches and retry.
M={{ ollama_model }}
CTX={{ ollama_context }}  # keep equal to the HA agent's context, or HA's first request reloads the model
for i in $(seq 60); do curl -sf http://127.0.0.1:11434/api/version >/dev/null && break; sleep 1; done
for i in $(seq 120); do curl -s -o /dev/null http://127.0.0.1:{{ whisper_server_port }}/ && break; sleep 1; done
for i in $(seq 90); do python3 -c "import socket; socket.create_connection(('127.0.0.1', {{ phonon_port }}), 1)" 2>/dev/null && break; sleep 2; done  # Phonon listens once warmed
on_gpu() {  # prints e.g. "100" (percent of the model in GPU memory), via the API: the CLI needs $HOME
  curl -sf http://127.0.0.1:11434/api/ps | python3 -c "import json,sys
m=[x for x in json.load(sys.stdin)['models'] if x['name']=='$M']
print(round(100*m[0]['size_vram']/m[0]['size']) if m else 0)"
}
warm() {  # read HA's system prompt and tools once, so HA's first request reuses them
  W=/var/lib/ollama-preload/ha-request.json  # written by tools/capture_ha_prompt.py
  [ -f "$W" ] || { echo "no $W, skipping warm-up"; return; }
  python3 -c "import json,sys
r=json.load(open('$W'))
r.update(messages=r['messages']+[{'role':'user','content':'Hello'}], stream=False, keep_alive=-1, think=False)
r['options']=dict(r.get('options',{}), num_predict=1)
print(json.dumps(r))" | curl -sf http://127.0.0.1:11434/api/chat -d @- | python3 -c "import json,sys
r=json.load(sys.stdin); print('warmed HA prompt:', r.get('prompt_eval_count'), 'tokens in', round(r.get('prompt_eval_duration',0)/1e9,1), 's')"
}
for try in 1 2 3; do
  curl -sf http://127.0.0.1:11434/api/generate -d "{\"model\":\"$M\",\"keep_alive\":-1,\"options\":{\"num_ctx\":$CTX}}" >/dev/null
  g=$(on_gpu)
  if [ "$g" = 100 ]; then echo "$M loaded, 100% GPU"; warm; exit 0; fi
  echo "try $try: only $g% on the GPU, reloading"
  curl -sf http://127.0.0.1:11434/api/generate -d "{\"model\":\"$M\",\"keep_alive\":0}" >/dev/null
  sync; echo 1 > /proc/sys/vm/drop_caches; sleep 5
done
echo "$M could not be loaded fully on the GPU"; exit 1
